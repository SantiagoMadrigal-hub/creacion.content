# =============================================================================
# LAVOX - Variables de entorno de ejemplo
# =============================================================================
# Copia este archivo a `.env` y completa tus propios valores.
# NUNCA subas el archivo `.env` real a control de versiones (ver .gitignore).
#
# Convención: LAVOX_<CAMPO> para valores de nivel superior y
# LAVOX_<GRUPO>__<CAMPO> (doble guion bajo) para valores anidados.
# =============================================================================

# --- General ---------------------------------------------------------------
LAVOX_ENVIRONMENT=development
LAVOX_LOG_LEVEL=INFO
# console (legible en terminal) o json (para agregadores de logs en prod)
LAVOX_LOG_FORMAT=console

# --- Rutas del pipeline (opcional, tienen valores por defecto) -------------
# LAVOX_SCRIPT_PATH=guion.txt
# LAVOX_SCENES_OUTPUT_PATH=escenas_con_videos.json
# LAVOX_CLIPS_DIR=videos
# LAVOX_AUDIO_PATH=audios/vozenoff_completa.mp3
# LAVOX_FINAL_OUTPUT_PATH=video_final_definitivo.mp4

# --- LLM (Groq como proveedor principal, OpenAI como fallback opcional) ----
LAVOX_LLM__GROQ_API_KEY=gsk_your_groq_api_key_here
LAVOX_LLM__OPENAI_API_KEY=sk-your_openai_api_key_here
# LAVOX_LLM__GROQ_MODEL=llama-3.1-8b-instant
# LAVOX_LLM__OPENAI_MODEL=gpt-4o-mini
# LAVOX_LLM__MAX_RETRIES=3
# LAVOX_LLM__REQUEST_TIMEOUT=30.0

# --- Pexels ------------------------------------------------------------------
LAVOX_PEXELS__API_KEY=your_pexels_api_key_here
# LAVOX_PEXELS__PER_PAGE=10
# LAVOX_PEXELS__MIN_WIDTH=1280
# LAVOX_PEXELS__REQUEST_TIMEOUT=20.0

# --- FFmpeg ------------------------------------------------------------------
# LAVOX_FFMPEG__BINARY=ffmpeg
# LAVOX_FFMPEG__PROBE_BINARY=ffprobe
# LAVOX_FFMPEG__RESOLUTION_WIDTH=1920
# LAVOX_FFMPEG__RESOLUTION_HEIGHT=1080
# LAVOX_FFMPEG__PRESET=fast
# LAVOX_FFMPEG__CRF=23
# LAVOX_FFMPEG__PROCESS_TIMEOUT=120.0

# --- Pipeline ------------------------------------------------------------------
# LAVOX_PIPELINE__RELEVANCE_THRESHOLD=70
# LAVOX_PIPELINE__MAX_CURATION_ATTEMPTS=2
# LAVOX_PIPELINE__MAX_DOWNLOAD_CONCURRENCY=5
# LAVOX_PIPELINE__DOWNLOAD_MAX_RETRIES=3
# LAVOX_PIPELINE__DOWNLOAD_TIMEOUT=60.0
# LAVOX_PIPELINE__MIN_LINE_LENGTH_FOR_GROUPING=60
# LAVOX_PIPELINE__MAX_SCENES_BEFORE_GROUPING=45
# Contexto que se le da al LLM al analizar cada línea del guion. Cambia esto
# si tu guion no trata sobre el mismo tema que el proyecto original.
# LAVOX_PIPELINE__CONTEXTO_NARRATIVO=Documental sobre palabras en inglés con orígenes engañosos.
